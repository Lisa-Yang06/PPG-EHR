# Copy to .env and edit. .env is gitignored; this file is not.
#   source .env        (or export these in your SLURM job script)
# Check what resolved with:  python paths.py

# Derived data the pipeline writes and re-reads: patient_history_db_*.joblib,
# MIMIC_{III,IV}_ppg_filtered_by_patient/, splits/, the ds*/ task directories.
PPG_DATA_ROOT=/path/to/derived_data

# Model checkpoints: best_medbert_model_*.pt, best_aligned_model_*.pt,
# and the PaPaGei-s weights.
PPG_CKPT_ROOT=/path/to/checkpoints

# A clone of the PaPaGei foundation-model repository. Imported, not vendored;
# see README for the pinned commit.
PAPAGEI_REPO=/path/to/papagei-foundation-model

# OPTIONAL. Only set this if your home directory is too small or read-only for
# library caches -- typical on a shared cluster, unnecessary on a workstation.
# When unset, caches go wherever your system normally puts them.
# PPG_CACHE_ROOT=/path/to/scratch/.cache
